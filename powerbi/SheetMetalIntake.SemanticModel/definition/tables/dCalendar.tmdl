table dCalendar
	lineageTag: 807d040c-b878-5649-b49e-f768936bb4f1
	dataCategory: Time

	column date
		dataType: dateTime
		formatString: yyyy-mm-dd
		isKey
		lineageTag: 642b5411-bafc-5cba-9df8-778f46ad8aaa
		summarizeBy: none
		sourceColumn: date

		annotation SummarizationSetBy = Automatic

	column year
		dataType: int64
		formatString: 0
		lineageTag: 1d5afea5-c6d0-53a9-b7f2-19d44b4ecf7d
		summarizeBy: none
		sourceColumn: year

		annotation SummarizationSetBy = Automatic

	column month_number
		dataType: int64
		formatString: 0
		lineageTag: 9250d28b-60e2-5371-84a9-a20cce0d299d
		summarizeBy: none
		sourceColumn: month_number

		annotation SummarizationSetBy = Automatic

	column year_month_number
		dataType: int64
		formatString: 0
		lineageTag: 4306f524-ac58-5dc3-b6e5-ca2771ca1c5a
		summarizeBy: none
		sourceColumn: year_month_number

		annotation SummarizationSetBy = Automatic

	column month_label
