		sourceColumn: sheets_ordered

		annotation SummarizationSetBy = Automatic

	column sheets_received
		dataType: int64
		formatString: #,0
		lineageTag: e8e11570-24e8-537f-bd5e-6b37a211e704
		summarizeBy: sum
		sourceColumn: sheets_received

		annotation SummarizationSetBy = Automatic

	column ordered_kg
		dataType: double
		formatString: #,0
		lineageTag: 853b97ac-8b83-5d3e-bab6-d7db69e7003d
		summarizeBy: sum
		sourceColumn: ordered_kg

		annotation SummarizationSetBy = Automatic

	column received_kg
		dataType: double
		formatString: #,0
		lineageTag: 9fd7d8b4-cce4-5b7f-b8f7-c341361d818e
		summarizeBy: sum
		sourceColumn: received_kg

		annotation SummarizationSetBy = Automatic

	column price_brl_kg
		dataType: double
		formatString: #,0.00
		lineageTag: d92cc115-d865-5bf2-9f49-83617eec6005
		summarizeBy: none
		sourceColumn: price_brl_kg

		annotation SummarizationSetBy = Automatic

	column promised_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 9e759a3f-f922-5c49-a9dc-f38db3e4c894
		summarizeBy: none
		sourceColumn: promised_date

		annotation SummarizationSetBy = Automatic

	column received_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: c714084b-1acc-57eb-971b-140a75b2f792
		summarizeBy: none
		sourceColumn: received_date

		annotation SummarizationSetBy = Automatic

	column inspection_result
		dataType: string
		lineageTag: 841c31f8-ba54-5828-84da-995db3325c78
		summarizeBy: none
		sourceColumn: inspection_result

		annotation SummarizationSetBy = Automatic

	column nonconformity
		dataType: string
		lineageTag: 10677c9e-2c44-53f7-8e3c-acdfff695fad
		summarizeBy: none
		sourceColumn: nonconformity

		annotation SummarizationSetBy = Automatic

	column days_late =
			INT ( fReceipts[received_date] - fReceipts[promised_date] )
		dataType: int64
		formatString: 0
		lineageTag: 7068460e-b5ab-5af7-bb49-19711969b8a7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column spend_brl =
			fReceipts[received_kg] * fReceipts[price_brl_kg]
		dataType: double
		formatString: #,0.00
		lineageTag: 33122568-cce2-5fe0-a6f0-520135c97bd9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition fReceipts = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DataFolder & "sheet_metal_intake.xlsx"), null, true),
				    Sheet = Source{[Item="fReceipts",Kind="Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Sheet, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"receipt_id", type text}, {"po_number", type text}, {"po_date", type date}, {"supplier_id", type text}, {"material_id", type text}, {"sheet_size_mm", type text}, {"sheets_ordered", Int64.Type}, {"sheets_received", Int64.Type}, {"ordered_kg", type number}, {"received_kg", type number}, {"price_brl_kg", type number}, {"promised_date", type date}, {"received_date", type date}, {"inspection_result", type text}, {"nonconformity", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table
