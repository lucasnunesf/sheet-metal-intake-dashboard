table fReceipts
	lineageTag: 4090f0ae-c300-5f65-82c0-7dae99e39d44

	measure Receipts = COUNTROWS ( fReceipts )
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: 76488243-684b-5d4c-bf66-e4c36c1ecfc0

	measure 'Received (t)' = SUM ( fReceipts[received_kg] ) / 1000
		formatString: #,0.0
		displayFolder: 1 Volume
		lineageTag: e2041c04-3b14-56ee-88bf-61518d2faad0

	measure 'Spend (BRL)' = SUM ( fReceipts[spend_brl] )
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: e798c703-c411-5b5b-98cd-091aeb433d83

	measure 'Avg Price (BRL/kg)' =
			-- weighted by kg, not a simple average of prices
			DIVIDE ( [Spend (BRL)], SUM ( fReceipts[received_kg] ) )
		formatString: #,0.00
		displayFolder: 1 Volume
		lineageTag: fee76c2d-851a-5598-bbb7-5906004a3cc8

	measure 'On-Time %' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( fReceipts ), fReceipts[days_late] <= 0 ),
			    [Receipts]
			)
		formatString: 0.0%
		displayFolder: 2 Delivery
		lineageTag: ac35058f-d76f-5bfe-a296-b62a0e3c6241

	measure 'Late Receipts' = CALCULATE ( COUNTROWS ( fReceipts ), fReceipts[days_late] > 0 )
		formatString: #,0
		displayFolder: 2 Delivery
		lineageTag: 2398ed12-7cbc-5891-996d-a146ece526c8

	measure 'Avg Days Late' =
			-- only receipts that arrived after the promised date
			CALCULATE ( AVERAGE ( fReceipts[days_late] ), fReceipts[days_late] > 0 )
		formatString: #,0.0
		displayFolder: 2 Delivery
		lineageTag: 20f49173-77ab-57ad-953a-27c4db46b600

	measure 'Fill Rate %' = DIVIDE ( SUM ( fReceipts[received_kg] ), SUM ( fReceipts[ordered_kg] ) )
		formatString: 0.0%
		displayFolder: 2 Delivery
		lineageTag: e8f63eb6-8f40-5bb9-b5d8-95d9306fcdd6

	measure Nonconformities = CALCULATE ( COUNTROWS ( fReceipts ), fReceipts[nonconformity] <> "No issue" )
		formatString: #,0
		displayFolder: 3 Quality
		lineageTag: 283c15c0-cf92-53fe-b7c0-9757cf3a8dca

	measure 'Nonconformity Rate %' = DIVIDE ( [Nonconformities], [Receipts] )
		formatString: 0.0%
		displayFolder: 3 Quality
		lineageTag: ab54edcf-f954-549d-8e7e-c699bf65bec5

	measure 'Rejection Rate %' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( fReceipts ), fReceipts[inspection_result] = "Rejected" ),
			    [Receipts]
			)
		formatString: 0.0%
		displayFolder: 3 Quality
		lineageTag: 9639c5f8-3458-5ab1-ba73-75630d7e0743

	measure 'Price vs Reference %' =
			-- paid price compared with the material's reference price
			VAR paid = [Avg Price (BRL/kg)]
			VAR reference =
			    DIVIDE (
			        SUMX ( fReceipts, fReceipts[received_kg] * RELATED ( dMaterial[reference_price_brl_kg] ) ),
			        SUM ( fReceipts[received_kg] )
			    )
			RETURN DIVIDE ( paid - reference, reference )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 1 Volume
		lineageTag: bad1420a-381e-5300-8daf-994b7d552080

	column receipt_id
		dataType: string
		lineageTag: ad942c62-76d0-5f86-891c-23baa169d5ba
		summarizeBy: none
		sourceColumn: receipt_id

		annotation SummarizationSetBy = Automatic

